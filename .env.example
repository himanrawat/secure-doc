# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database
MONGODB_URI=mongodb://localhost:27017/secure-doc-viewer
DB_NAME=secure_doc_viewer

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=24h
ENCRYPTION_KEY=your-32-character-encryption-key
ENCRYPTION_IV=your-16-character-iv-key

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@securedoc.com

# Webhook Configuration
WEBHOOK_URL=https://your-webhook-endpoint.com/notify
WEBHOOK_SECRET=your-webhook-secret

# Client Configuration
CLIENT_URL=http://localhost:3000

# Camera & AI Configuration
FACE_MATCH_THRESHOLD=0.6
OBSTRUCTION_THRESHOLD=10
EXTERNAL_CAMERA_CONFIDENCE=0.7
BLINK_DETECTION_EAR_THRESHOLD=0.25

# Session Configuration
SESSION_HEARTBEAT_INTERVAL=5000
MAX_VIOLATION_COUNT=3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./uploads

# Security Levels
SECURITY_LEVEL_LOW=1
SECURITY_LEVEL_MEDIUM=2
SECURITY_LEVEL_HIGH=3
SECURITY_LEVEL_MAXIMUM=4
